# Razorpay Configuration
# Get these from your Razorpay dashboard: https://dashboard.razorpay.com/

# Public key (visible in frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Secret key (keep private, only for backend)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: Database configuration for storing enrollments
DATABASE_URL=your_database_url_here

# Optional: Email service configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@panha.com